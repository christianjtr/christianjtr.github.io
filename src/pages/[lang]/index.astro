---
import '@fontsource/lato/index.css';
import { getEntry } from 'astro:content';

import { contentDataEntries, CONTENT } from '@app-types/Content';
import type { ContentDataEntryType } from '@app-types/Content';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import { Header, Footer, MainWrapper } from '@layouts';
import { VerticalIconMenu, LocaleBanner } from '@components';
import { OpenGraph } from '@components/sections';
import '@styles/global.css';

export function getStaticPaths() {
    const pages = contentDataEntries.map((locale) => ({
        params: { lang: locale }
    }));

    return pages;
}

const { lang } = Astro.params;
const pageTitle = "Christian José Torrealba Rondón";
const rootTheme = { theme: 'light' };

const entry = await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`);
const { header } = (entry?.data as AboutMeData) || {};
---

<html lang={lang} data-theme="light" {...rootTheme}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <OpenGraph />
        <title>{pageTitle}</title>
    </head>
    <body>
        <a href="#main-content" class="skip-link">Skip to main content</a>
        <Header transition:persist />
        <LocaleBanner
            currentLocale={lang!}
            languages={header.languages}
            bannerText={header.locale_banner}
        />
        <main id="main-content">
            <MainWrapper transition:animate="fade" />
        </main>
        <div class="vertical-icon-menu-wrapper hidden lg:flex" transition:persist>
            <VerticalIconMenu />
        </div>
        <button 
            id="scroll-top-button" 
            class="scroll-top-button" 
            type="button"
            aria-label="Scroll to top"
            aria-hidden="true"
            transition:name="scroll-top"
        >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <path d="M12 19V5m0 0L6 11m6-6 6 6" />
            </svg>
        </button>
        <Footer transition:persist />

    </body>
</html>

<style>
    @reference "@styles/global.css";

    .skip-link {
        @apply absolute left-4 top-4 z-50 rounded bg-primary px-4 py-2 text-white transition-transform;
        transform: translateY(-200%);
    }

    .skip-link:focus-visible {
        transform: translateY(0);
    }
    
    html {
        scroll-behavior: smooth;
    }
    
    .vertical-icon-menu-wrapper {
        @apply fixed top-1/3 right-5 z-1;
    }

    .scroll-top-button {
        position: fixed;
        right: clamp(1.25rem, 3vw, 2.5rem);
        bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
        z-index: 40;
        display: none;
        width: 3.5rem;
        height: 3.5rem;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, var(--color-primary) 30%, white);
        border-radius: 50%;
        background: color-mix(in srgb, var(--color-primary) 92%, white);
        color: white;
        box-shadow: 0 8px 24px rgb(15 23 42 / 0.2), inset 0 1px 0 rgb(255 255 255 / 0.22);
        cursor: pointer;
        transition: transform 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
        -webkit-tap-highlight-color: transparent;
    }

    .scroll-top-button svg {
        width: 1.35rem;
        height: 1.35rem;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .scroll-top-button:hover {
        transform: translateY(-3px);
        background: var(--color-primary);
        box-shadow: 0 12px 28px rgb(15 23 42 / 0.26), 0 0 0 4px color-mix(in srgb, var(--color-primary) 14%, transparent);
    }

    .scroll-top-button:focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: 4px;
    }

    :global(html[data-theme="dark"]) .scroll-top-button {
        border-color: color-mix(in srgb, var(--color-accent) 48%, transparent);
        background: var(--color-accent);
        color: #0f172a;
        box-shadow: 0 8px 24px rgb(0 0 0 / 0.36), inset 0 1px 0 rgb(255 255 255 / 0.3);
    }

    :global(html[data-theme="dark"]) .scroll-top-button:hover {
        background: color-mix(in srgb, var(--color-accent) 84%, white);
        box-shadow: 0 12px 28px rgb(0 0 0 / 0.44), 0 0 0 4px color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    @media (max-width: 640px) {
        .scroll-top-button {
            right: 1rem;
            bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            width: 3rem;
            height: 3rem;
        }

        .scroll-top-button svg {
            width: 1.2rem;
            height: 1.2rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .scroll-top-button {
            transition: none;
        }

        .scroll-top-button:hover {
            transform: none;
        }
    }
</style>

<script>
    const scrollDownUntil = 2500;
    const scrollToTopButton = document.getElementById("scroll-top-button");

    if (scrollToTopButton instanceof HTMLButtonElement) {
        const updateScrollButton = () => {
            const isVisible = window.scrollY > scrollDownUntil;
            scrollToTopButton.style.display = isVisible ? "flex" : "none";
            scrollToTopButton.setAttribute("aria-hidden", String(!isVisible));
        };

        window.addEventListener("scroll", updateScrollButton, { passive: true });
        updateScrollButton();

        scrollToTopButton.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
            window.history.replaceState({}, "", window.location.href.split("#")[0]);
        });
    }
</script>
 