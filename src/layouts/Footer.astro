---
import { getEntry } from 'astro:content';

import type { ContentDataEntryType } from '@app-types/Content';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import { CONTENT } from '@app-types/Content';
import AstroIcon from '@assets/svg/astro.svg';
import DaisyUIIcon from '@assets/svg/daisyui.svg';

const { lang } = Astro.params;

const entry = await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`);
const { section_about, footer } = (entry?.data as AboutMeData) || {};

const appVersion = __APP_VERSION__;
const copyrights = `Copyrights © ${new Date().getFullYear()}`;
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
        <p class="footer-name" set:html={section_about.my_name}></p>
        <div class="footer-meta">
          <span>{copyrights}</span>
          <span class="footer-version">v{appVersion}</span>
        </div>
    </div>
    <nav class="footer-group">
      <h6 class="footer-title">{footer.powered_and_themed_by}</h6>
        <div class="footer-logos">
          <a class="footer-logo-link" href="https://astro.build" target="_blank" rel="noopener noreferrer" aria-label="Astro website">
            <AstroIcon class="footer-logo" />
        </a>
          <a class="footer-logo-link" href="https://daisyui.com" target="_blank" rel="noopener noreferrer" aria-label="DaisyUI website">
            <DaisyUIIcon class="footer-logo" />
        </a>
      </div>
    </nav>
    <nav class="footer-group">
      <h6 class="footer-title">{footer.assets}</h6>
        <div class="footer-links">
          <a href="https://www.svgrepo.com" target="_blank" rel="noopener noreferrer">SVG Repo</a>
          <a href="https://googlefonts.github.io/noto-emoji-animation" target="_blank" rel="noopener noreferrer">Animated Emoji</a>
      </div>
    </nav>
  </div>
</footer>

<style>
  @reference "@styles/global.css";

  .site-footer {
    @apply relative overflow-hidden bg-[#202635] text-slate-50;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 5vw, 4rem);
  }

  .site-footer::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), var(--color-primary), transparent);
    content: "";
    pointer-events: none;
  }

  .footer-shell {
    @apply mx-auto grid w-full max-w-[80rem] items-start;
    grid-template-columns: minmax(12rem, 1.2fr) minmax(12rem, 1fr) minmax(10rem, 0.8fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .footer-brand,
  .footer-group {
    @apply min-w-0;
  }

  .footer-name {
    @apply m-0 text-[1.1rem] font-bold tracking-[-0.02em] text-white;
  }

  .footer-meta {
    @apply mt-[0.35rem] flex flex-wrap gap-x-[0.8rem] gap-y-[0.4rem] text-[0.72rem] text-[#aeb8c7];
  }

  .footer-version {
    @apply font-mono text-accent;
  }

  .footer-title {
    @apply m-0 mb-[0.55rem] text-[0.67rem] font-bold tracking-[0.13em] text-[#aeb8c7];
  }

  .footer-logos {
    @apply flex flex-wrap items-center gap-3;
  }

  .footer-logo-link {
    @apply inline-flex min-h-9 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] px-[0.65rem] py-[0.4rem] transition-[border-color,background-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent/45 hover:bg-white/[0.08];
  }

  .footer-logo {
    @apply block max-h-6 w-[5.25rem];
  }

  .footer-links {
    @apply flex flex-col items-start gap-[0.35rem];
  }

  .footer-links a {
    @apply text-[0.84rem] text-white decoration-transparent underline-offset-[0.2em] transition-colors duration-200 hover:text-accent hover:underline;
  }

  @media (max-width: 767px) {
    .footer-shell {
      @apply grid-cols-1 justify-items-center gap-4 text-center;
    }

    .footer-meta,
    .footer-logos {
      @apply justify-center;
    }

    .footer-group {
      @apply flex flex-col items-center;
    }

    .footer-title {
      @apply mb-[0.4rem];
    }

    .footer-links {
      @apply flex-row flex-wrap justify-center gap-x-4 gap-y-2;
    }
  }
</style>
