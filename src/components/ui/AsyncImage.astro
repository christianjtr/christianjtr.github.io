---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
const { imagePath, title } = Astro.props;

const imageModules = import.meta.glob<ImageMetadata>("/src/assets/**/*.{jpeg,jpg,png,webp}", {
    eager: true,
    import: "default",
});
const imageModule = imageModules[imagePath];
---

{imageModule ? (
    <Image 
        src={imageModule} 
        alt={`Image for ${title}`}
        loading="lazy"
        inferSize
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
    />
) : (
    <span>Image Missing: {imagePath}</span>
)}
