---
import type { HTMLAttributes } from 'astro/types';
import ExternalLinkIcon from '@components/ui/ExternalLinkIcon.astro';

interface Props extends HTMLAttributes<'a'> {
    displayDefaultIcon?: boolean;
    class?: string;
}

const { displayDefaultIcon = false, class: className = "", ...attributes } = Astro.props;
---

<a class:list={['link-button', className]} {...attributes}>
    <slot />
    <slot name="icon" />
    {displayDefaultIcon && <ExternalLinkIcon />}
</a>

<style>
    @reference "tailwindcss";

    @reference "@styles/global.css";

    .link-button {
        @apply btn btn-lg flex w-fit gap-2 rounded-4xl border-0 bg-primary text-white transition-all duration-300 ease-in-out;
    }

    .link-button:hover {
        @apply scale-110;
    }

    a.btn-circle {
        @apply w-9 h-9;
    }
</style>
