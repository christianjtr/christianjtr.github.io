---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
    headingTitle: string;
    subtitle?: string;
    headingClass?: string;
}

const { headingTitle, headingClass, subtitle, ...attributes } = Astro.props;
---

<section {...attributes}>
    <div class="title-wrapper">
        <slot name="beforeHeading"/>
        <div>
            <h1 class:list={[headingClass, 'section-heading']}>{headingTitle}</h1>
            {subtitle && (<span class="section-subtitle">{subtitle}</span>)}
        </div>
    </div>
    <slot />
</section>

<style>
    @reference "@styles/global.css";

    .title-wrapper {
        @apply my-6 flex flex-col items-start gap-3 px-5 lg:flex-row lg:items-center lg:px-0;
    }

    .section-heading {
        @apply mb-1 font-semibold text-base-content;
        font-size: clamp(2rem, 3vw, 2.75rem);
    }

    .section-subtitle {
        @apply block text-lg font-light text-neutral-500 dark:text-base-content;
    }

    h1::after {
        content: ".";
        @apply text-5xl text-accent;
    }
</style>