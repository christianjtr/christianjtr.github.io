---
import { getEntry } from 'astro:content';
import type { ContentDataEntryType } from '@app-types/Content';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import { CONTENT } from '@app-types/Content';
import { ModalHeader } from '@components';

interface ExpertiseSubject {
    name: string;
    topics: string[];
}

interface Props {
    subject: ExpertiseSubject;
    modalId: string;
}

const { lang } = Astro.params;
const { subject, modalId } = Astro.props;

const commonData = await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`);
const { common } = (commonData?.data as AboutMeData) || {};
---

<dialog id={modalId} class="modal modal-middle px-4 md:px-0" aria-labelledby={`${modalId}_title`} onclick="event.stopPropagation()">
    <div class="modal-box expertise-modal-box">
        <ModalHeader
            eyebrow={common.key_areas}
            title={subject.name}
            titleId={`${modalId}_title`}
            closeLabel={common.close_dialog}
        />
        <div class="expertise-modal-chip-list">
            {subject.topics.map((topic) => (
                <span class="expertise-modal-chip">
                    {topic}
                </span>
            ))}
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

<style>
    @reference "@styles/global.css";

    .expertise-modal-box {
        @apply w-full max-w-md rounded-2xl border border-base-300 bg-base-100 p-6 text-base-content shadow-2xl transition-all duration-300;
    }

    .expertise-modal-chip-list {
        @apply flex flex-wrap items-center gap-x-2 gap-y-3 text-sm font-semibold tracking-tight;
    }

    .expertise-modal-chip {
        @apply cursor-default select-none rounded-xl border border-base-300 bg-base-200 px-3 py-1.5 text-base-content/80 transition-colors duration-200 hover:border-primary/50;
    }

    :global(html[data-theme="dark"]) .expertise-modal-chip:hover {
        @apply border-accent/50;
    }

</style>
