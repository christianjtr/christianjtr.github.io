---
import type { AboutMeData } from '@schemas/AboutMeSchema';
import AboutBackground from './AboutBackground.astro';
import AboutLanguages from './AboutLanguages.astro';

interface Props {
    common: AboutMeData['common'];
    sectionAbout: AboutMeData['section_about'];
    experiences: AboutMeData['section_experiences'];
    studies: AboutMeData['section_studies'];
}

const { common, sectionAbout, experiences, studies } = Astro.props;
---

<div class="about-profile-panel">
    <div class="about-manifesto">
        <h3 class="manifesto-title">{sectionAbout.about_me_title}</h3>
        <p class="about-availability">
            <span class="about-availability-indicator" aria-hidden="true"></span>
            {sectionAbout.availability}
        </p>
        <p class="manifesto-body">{sectionAbout.about_me}</p>
    </div>
    <AboutLanguages languages={sectionAbout.languages} languageTip={sectionAbout.language_tip} />
    <AboutBackground common={common} experiences={experiences} studies={studies} />
</div>

<style is:global>
    @reference "@styles/global.css";

    .about-availability {
        @apply text-xs;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0.65rem 0 0;
        color: var(--color-secondary);
        font-weight: 600;
        line-height: 1.5;
    }

    .about-availability-indicator {
        width: 0.5rem;
        height: 0.5rem;
        flex: 0 0 auto;
        border-radius: 50%;
        background: var(--color-secondary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-secondary) 15%, transparent);
    }

    .about-detail-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        line-height: 1.5;
        text-transform: uppercase;
    }

    .about-detail-pulse {
        width: 0.45rem;
        height: 0.45rem;
        flex: 0 0 auto;
        border-radius: 50%;
        background: var(--color-accent);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 14%, transparent);
    }

    html[data-theme="dark"] .about-detail-label {
        color: var(--color-accent);
    }

    .about-profile-panel {
        align-self: start;
        padding: clamp(1.1rem, 2.5vw, 1.75rem);
    }

    .manifesto-title {
        margin: 0;
        color: var(--color-base-content);
        font-size: clamp(1.08rem, 1.6vw, 1.35rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.4;
        text-wrap: pretty;
    }

    .manifesto-body {
        margin: 0.85rem 0 0;
        padding-left: 0.9rem;
        border-left: 2px solid var(--color-primary);
        color: var(--color-base-content);
        font-size: 0.92rem;
        line-height: 1.75;
        opacity: 0.76;
    }

    html[data-theme="dark"] .manifesto-body {
        border-color: var(--color-accent);
    }

    .about-languages .about-detail-label {
        margin-bottom: 0.35rem;
    }

    @media (max-width: 1023px) {
        .about-profile-panel {
            padding: clamp(1rem, 4vw, 1.5rem);
        }
    }

    @media (max-width: 639px) {
        .about-detail-label {
            font-size: 0.6rem;
            letter-spacing: 0.09em;
        }
    }
</style>
