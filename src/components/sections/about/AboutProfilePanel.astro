---
import type { AboutMeData } from "@schemas/AboutMeSchema";
import AboutLanguages from "./AboutLanguages.astro";

interface Props {
    sectionAbout: AboutMeData["section_about"];
}

const { sectionAbout } = Astro.props;
---

<div class="about-profile-panel">
    <div class="about-manifesto">
        <h2 class="manifesto-title">{sectionAbout.about_me_title}</h2>
        <br />
        <p class="about-availability">
            <span
                class="about-availability-indicator"
                aria-hidden="true"
            ></span>
            {sectionAbout.availability}
        </p>
        <p class="manifesto-body">{sectionAbout.about_me}</p>
    </div>
    <br />
    <AboutLanguages
        languages={sectionAbout.languages}
        languageTip={sectionAbout.language_tip}
    />
</div>

<style is:global>
    @reference "@styles/global.css";

    .about-availability {
        @apply text-sm;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 1.15rem 0 0;
        color: #a50e5d;
        font-weight: 600;
        line-height: 1.5;
    }

    html[data-theme="dark"] .about-availability {
        color: #f9a8d4;
    }

    .about-availability-indicator {
        width: 0.5rem;
        height: 0.5rem;
        flex: 0 0 auto;
        border-radius: 50%;
        background: var(--color-secondary);
        box-shadow: 0 0 0 3px
            color-mix(in srgb, var(--color-secondary) 15%, transparent);
    }

    .about-detail-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        line-height: 1.5;
        text-transform: uppercase;
    }

    .about-detail-pulse {
        width: 0.45rem;
        height: 0.45rem;
        flex: 0 0 auto;
        border-radius: 50%;
        background: var(--color-accent);
        box-shadow: 0 0 0 4px
            color-mix(in srgb, var(--color-accent) 14%, transparent);
    }

    html[data-theme="dark"] .about-detail-label {
        color: var(--color-accent);
    }

    .about-profile-panel {
        align-self: start;
        padding: clamp(0.25rem, 1vw, 0.75rem) 0;
        border: 0;
        background: transparent;
        box-shadow: none;
    }

    html[data-theme="dark"] .about-profile-panel {
        border: 0;
        background: transparent;
        box-shadow: none;
    }

    .manifesto-title {
        margin: 0;
        color: var(--color-base-content);
        font-size: clamp(1.12rem, 1.65vw, 1.4rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.5;
        text-wrap: pretty;
    }

    .manifesto-body {
        margin: 1.5rem 0 0;
        padding-left: 1rem;
        border-left: 3px solid var(--color-primary);
        color: var(--color-base-content);
        font-size: 0.95rem;
        line-height: 1.85;
        opacity: 0.82;
    }

    html[data-theme="dark"] .manifesto-body {
        border-color: var(--color-accent);
    }

    .about-languages .about-detail-label {
        margin-bottom: 0.35rem;
    }

    @media (max-width: 1023px) {
        .about-profile-panel {
            padding: clamp(0.25rem, 1vw, 0.75rem) 0;
        }
    }

    @media (max-width: 639px) {
        .about-detail-label {
            font-size: 0.6rem;
            letter-spacing: 0.09em;
        }
    }

    @media (min-width: 1024px) {
        .about-availability {
            margin-top: 1.15rem;
        }

        .manifesto-body {
            margin-top: 1.5rem;
        }
    }
</style>
