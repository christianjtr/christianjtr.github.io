---
import { getCollection, getEntry } from 'astro:content';

import type { ContentDataEntryType } from '@app-types/Content';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import type { Experiment, ExperimentRole } from '@schemas/ExperimentSchema';
import { CONTENT } from '@app-types/Content';
import { BadgeList, LinkButton, Section, Badge, AsyncImage } from "@components";
import Logo from '@assets/svg/case_of_studies.svg';
import TrashIcon from '@assets/svg/trash.svg';
import ExperimentAbstractModal from '@components/modals/ExperimentAbstractModal.astro';

const roleIcons: Record<ExperimentRole, string> = {
    'Author': '🧑🏻‍💻',
    'Contributor': '🤝🏼'
};

const { lang } = Astro.params;

const [commonData, [ experimentsData ]] = await Promise.all([
    await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`),
    await getCollection(lang as ContentDataEntryType, (collection) => collection.id === `${lang}/${CONTENT.EXPERIMENTS}`)
]);

const { section_experiments, common, header } = (commonData?.data as AboutMeData) || {};
const { data: experiments } = experimentsData as { data: Experiment[]};

const experimentsToDisplay = experiments.filter(exp => exp.display && !exp.isSandbox);
const featuredExperiments = experimentsToDisplay;
const uniqueTopics = Array.from(
    featuredExperiments.reduce((topics, { topic }) => {
        topics.set(topic, (topics.get(topic) ?? 0) + 1);
        return topics;
    }, new Map<string, number>())
).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<div class="bg-primary/5 py-10" id={header.main_sections[2].anchorId}>
    <br />
    <Section headingTitle={section_experiments.title} subtitle={section_experiments.subtitle} class="container mx-auto px-1 lg:px-10">
        <Logo slot="beforeHeading" width={96} height={96} />
        <br />
        <div class="experiments-layout">
            <aside class="experiment-filters-column">
                <div class="filter-panel">
                    <div class="filter-panel__header">
                        <h3 class="filter-panel__title">{common.filter_experience}</h3>
                        <button type="reset" form="experiments-filter-form" class="filter-reset" aria-label={common.reset_filters}>
                            <TrashIcon class="w-4 h-4" />
                            <span>{common.reset_filters}</span>
                        </button>
                    </div>
                    <form id="experiments-filter-form" class="filter-options">
                        <label class="wip-filter-label">
                            <span>{common.filter_wip}</span>
                            <input class="toggle toggle-primary toggle-sm wip-filter" type="checkbox" name="experiments_wip" />
                        </label>
                        <div class="filter-topic-group">
                            <div class="filter-choices topic-options">
                                {uniqueTopics.map(([topic, count], index) => (
                                    <div class="topic-option" data-topic={topic}>
                                        <input
                                            class="topic-filter"
                                            type="checkbox"
                                            id={`topic-filter-${index}`}
                                            value={topic}
                                            name="experiments_topic"
                                        />
                                        <label for={`topic-filter-${index}`} class="filter-choice-label">
                                            <span class="filter-choice-name">{topic}</span>
                                            <span class="filter-choice-count">{count}</span>
                                        </label>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </form>
                </div>
            </aside>
            <main class="experiment-cards">
                {featuredExperiments.map((experiment: Experiment, index) => (
                    <div
                        class="card experiment-card"
                        data-topic={experiment.topic}
                        data-wip={experiment.isWIP ? 'true' : 'false'}
                    >
                        <div class="experiment-image-wrap">
                            <figure class="experiment-image-stage">
                                <div class="experiment-image-frame">
                                    <AsyncImage 
                                        imagePath={experiment.image} 
                                        title={experiment.title} 
                                        loading="lazy"
                                    />
                                </div>
                            </figure>
                        </div>
                        <div class="experiment-card-content">
                                <div class="experiment-card-meta">
                                    <Badge class="badge-sm badge-primary uppercase">{experiment.category}</Badge>
                                    {experiment.year && <Badge class="badge-warning badge-sm font-semibold experiment-card-year">{experiment.year}</Badge>}
                                </div>
                                <div class="experiment-card-role">
                                    <span class="text-xl">{roleIcons[experiment.role]}</span>
                                    <span class="experiment-card-role-label">
                                        {experiment.role === "Author" ? `${common.author}` : `${common.contributor}`}
                                    </span>
                                    {experiment.isWIP && (
                                        <span class="experiment-status">
                                            <span class="experiment-status-indicator" aria-hidden="true"></span>
                                            {common.in_progress}
                                        </span>
                                    )}
                                </div>
                                <h2 class="experiment-card-title">{experiment.title}</h2>
                                <div class="experiment-card-type">{experiment.type}</div>
                                <p class="experiment-card-description">
                                    {experiment.description}
                                </p>
                            <div class="experiment-card-footer">
                                <BadgeList items={experiment.tags} badgeClass="font-semibold badge-soft text-[11px]" wrapperClass="experiment-card-tags" />
                                {(experiment.abstract || experiment.url) && (
                                    <div class="experiment-card-actions" style={!experiment.abstract && 'justify-content: end'}>
                                        {experiment.abstract && (
                                            <button
                                                class="btn btn-ghost btn-xs experiment-abstract-action"
                                                onclick={`document.getElementById('experiment_modal_${index}')?.showModal()`}
                                                aria-haspopup="dialog"
                                                aria-label={common.abstract}
                                            >
                                                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="h-3.5 w-3.5">
                                                    <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5" />
                                                    <path d="M10 9v4m0-6h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                                </svg>
                                                {common.abstract}
                                            </button>
                                        )}
                                        {experiment.url && (
                                            <LinkButton
                                                href={experiment.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="btn-circle btn-sm"
                                                displayDefaultIcon
                                                aria-label={`Open experiment: ${experiment.title}`}
                                                title={`Open experiment: ${experiment.title}`}
                                            >
                                                <span class="sr-only">Open experiment: {experiment.title}</span>
                                            </LinkButton>
                                        )}
                                    </div>
                                )}
                            </div>
                        </div>
                        {experiment.abstract && <ExperimentAbstractModal text={experiment.abstract} title={experiment.title} modalId={`experiment_modal_${index}`} /> }
                    </div>
                ))}
            </main>
        </div>
    </Section>
</div>


<style>
    @reference "@styles/global.css";
    
    .experiments-layout {
        @apply mt-4 flex flex-col gap-4 px-2 md:px-4 lg:px-14;
    }

    .experiment-filters-column {
        @apply z-30 w-full lg:sticky lg:top-20 lg:pb-4 lg:pt-4;
    }

    @media (min-width: 1024px) {
        .experiment-filters-column {
            background-color: color-mix(in srgb, var(--color-primary) 5%, var(--color-base-100));
        }
    }

    .experiment-cards {
        @apply grid grid-cols-1 gap-5 lg:grid-cols-2;
    }
    
    .card {
        @apply flex w-full flex-col overflow-hidden rounded-xl border border-neutral-200/70 bg-base-100 text-neutral-900 transition-colors duration-300;
    }

    .card:hover {
        @apply border-primary;
    }

    html[data-theme="dark"] .card {
        @apply border-neutral-800/80 bg-neutral-900 text-white;
    }

    html[data-theme="dark"] .card:hover {
        @apply border-accent/75;
    }

    .experiment-card-content {
        @apply flex min-w-0 flex-1 flex-col gap-3 p-4 sm:p-5;
    }

    .experiment-card-meta {
        @apply flex items-center justify-between gap-2;
    }

    .experiment-card-year {
        @apply font-mono tracking-wide;
    }

    .experiment-card-role {
        @apply flex items-center gap-2 text-xs;
    }

    .experiment-status {
        @apply ml-auto inline-flex items-center gap-1.5 text-[11px] font-semibold text-warning;
    }

    .experiment-status-indicator {
        @apply h-1.5 w-1.5 rounded-full bg-warning;
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-warning) 16%, transparent);
    }

    .experiment-card-role-label {
        @apply text-xs font-medium text-neutral-500 uppercase;
    }

    .experiment-card-title {
        @apply m-0 text-lg font-semibold leading-snug transition-colors;
    }

    .experiment-card-type {
        @apply text-sm font-semibold text-primary;
    }

    html[data-theme="dark"] .experiment-card-type {
        @apply text-accent;
    }

    .experiment-card-description {
        @apply m-0 text-sm leading-6 text-base-content;
    }

    .experiment-card-footer {
        @apply mt-auto border-t border-base-300 pt-2.5;
    }

    :global(.experiment-card-tags) {
        @apply w-full gap-2;
    }

    .experiment-card-actions {
        @apply mt-3 flex items-center justify-between gap-2 border-t border-base-300/70 pt-2.5;
    }

    .experiment-abstract-action {
        @apply gap-1.5;
    }

    .filter-panel {
        @apply rounded-xl border border-base-300/80 bg-base-100 px-3 py-2;
    }

    .filter-panel__header {
        @apply mb-1 flex items-center justify-between gap-2;
    }

    .filter-panel__title {
        @apply m-0 text-sm leading-tight font-extrabold tracking-tight text-base-content;
    }

    .filter-reset {
        @apply inline-flex min-h-7 shrink-0 cursor-pointer items-center justify-center gap-1 rounded-lg border border-transparent bg-transparent px-1.5 py-1 text-[11px] leading-none font-bold text-base-content/55 transition-colors duration-150;
    }

    .filter-reset:hover {
        @apply border-error/25 bg-error/10 text-error;
    }

    .filter-reset:focus-visible {
        @apply outline-3 outline-error/65 outline-offset-2;
    }

    .filter-options {
        @apply m-0 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3;
    }

    .filter-topic-group {
        @apply flex min-w-0 flex-1 flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-2;
    }

    .filter-topic-heading {
        @apply m-0 shrink-0 font-mono text-[10px] leading-tight font-extrabold tracking-[0.12em] text-base-content/55 uppercase;
    }

    .filter-choice-count {
        @apply inline-flex h-4 min-w-4 shrink-0 items-center justify-center rounded-full border border-primary/20 bg-primary/10 px-1 font-mono text-[10px] leading-none font-extrabold tracking-normal text-primary transition-colors;
    }

    .filter-choices {
        @apply flex flex-wrap gap-1.5;
    }

    .wip-filter-label {
        @apply flex min-h-8 cursor-pointer items-center justify-between gap-2 rounded-lg border border-base-300/70 bg-base-200/45 px-2.5 py-1 text-xs leading-snug font-bold text-base-content transition-all duration-200 sm:w-auto sm:shrink-0;
    }

    .wip-filter {
        @apply m-0 shrink-0 cursor-pointer;
    }

    :global(html[data-theme="dark"]) .wip-filter {
        --input-color: var(--color-accent);
    }

    .wip-filter-label:hover {
        @apply bg-primary/5;
    }

    .wip-filter-label:has(.wip-filter:checked) {
        @apply bg-primary/8 text-primary;
        box-shadow: inset 3px 0 0 var(--color-primary);
    }

    .wip-filter:focus-visible {
        @apply outline-3 outline-accent/70 outline-offset-2;
    }

    .topic-options {
        @apply pb-px;
    }

    .topic-filter {
        @apply sr-only;
    }

    .filter-choice-label {
        @apply inline-flex min-h-8 max-w-full cursor-pointer items-center gap-1.5 rounded-full border border-primary/25 bg-primary/6 py-1 pl-2.5 pr-1.5 text-xs leading-tight font-bold text-base-content wrap-break-word transition-all duration-200;
    }

    .filter-choice-label::before {
        content: "";
        @apply h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60 transition-all duration-200;
    }

    .filter-choice-label:hover {
        @apply -translate-y-px border-primary/55 bg-primary/12 text-primary shadow-sm shadow-primary/10;
    }

    .filter-choice-label:hover::before {
        @apply bg-primary;
    }

    .topic-filter:checked + .filter-choice-label {
        @apply border-primary bg-primary text-white shadow-sm shadow-primary/20;
    }

    .topic-filter:checked + .filter-choice-label::before {
        @apply bg-white ring-2 ring-white/30;
    }

    .topic-filter:checked + .filter-choice-label .filter-choice-count {
        @apply border-white/25 bg-white/15 text-white;
    }

    .topic-filter:focus-visible + .filter-choice-label {
        @apply outline-2 outline-primary outline-offset-2;
    }

    .filter-choice-name {
        @apply min-w-0 flex-1 wrap-break-word;
    }

    html[data-theme="dark"] .filter-choice-label {
        @apply border-accent/25 bg-accent/5 text-neutral-100;
    }

    html[data-theme="dark"] .filter-choice-count {
        @apply border-accent/25 bg-accent/10 text-accent;
    }

    html[data-theme="dark"] .filter-panel {
        @apply border-neutral-700/70 bg-neutral-900;
    }

    html[data-theme="dark"] .filter-panel__header {
        @apply border-neutral-700/80;
    }

    html[data-theme="dark"] .filter-panel__title {
        @apply text-base-content;
    }

    html[data-theme="dark"] .filter-reset:hover {
        @apply border-error/45 bg-error/15;
    }

    html[data-theme="dark"] .wip-filter-label {
        @apply border-transparent bg-neutral-950/25 text-neutral-200;
    }

    html[data-theme="dark"] .wip-filter-label:hover {
        @apply border-accent/50 bg-accent/10 text-accent;
    }

    html[data-theme="dark"] .wip-filter-label:has(.wip-filter:checked) {
        @apply bg-accent/10 text-accent;
        box-shadow: inset 3px 0 0 var(--color-accent);
    }

    html[data-theme="dark"] .filter-choice-label:hover {
        @apply border-accent/55 bg-accent/10 text-accent shadow-sm shadow-accent/5;
    }

    html[data-theme="dark"] .filter-choice-label:hover::before {
        @apply bg-accent;
    }

    html[data-theme="dark"] .topic-filter:checked + .filter-choice-label {
        @apply border-accent/70 bg-accent text-neutral-950 shadow-sm shadow-accent/10;
    }

    html[data-theme="dark"] .topic-filter:checked + .filter-choice-label::before {
        @apply bg-neutral-950 ring-2 ring-neutral-950/25;
    }

    html[data-theme="dark"] .topic-filter:checked + .filter-choice-label .filter-choice-count {
        @apply border-neutral-950/20 bg-neutral-950/10 text-neutral-950;
    }

    html[data-theme="dark"] .topic-filter:focus-visible + .filter-choice-label {
        @apply outline-accent;
    }

    .experiment-image-wrap {
        @apply min-w-0 overflow-hidden border-b border-base-300/70 transition-colors duration-300;
    }

    .experiment-image-stage {
        @apply relative m-0 w-full overflow-hidden px-3 py-5 md:px-4 md:py-6;
        background-color: #fafafa;
        background-image: radial-gradient(ellipse at 50% 50%, rgba(72,79,217,0.06), transparent 68%), linear-gradient(rgba(0,0,0,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.025) 1px, transparent 1px);
        background-size: auto, 24px 24px, 24px 24px;
    }

    :global(html[data-theme="dark"]) .experiment-image-stage {
        background-color: #0c101b;
        background-image: radial-gradient(ellipse at 50% 50%, rgba(41,242,185,0.06), transparent 68%), linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: auto, 24px 24px, 24px 24px;
    }

    .experiment-image-frame {
        @apply relative z-0 block w-full overflow-hidden rounded-xl transition-transform duration-500;
    }

    :global(.experiment-image-frame img) {
        @apply relative z-0 block h-auto w-full rounded-xl object-contain transition-transform duration-500;
    }

    @media (prefers-reduced-motion: reduce) {
        .experiment-image-frame,
        :global(.experiment-image-frame img) {
            transition-duration: 0.01ms;
        }
    }

</style>

<script>
    const setupFilters = () => {
    const topicFilters = document.querySelectorAll<HTMLInputElement>('.topic-filter');
    const wipFilter = document.querySelector<HTMLInputElement>('.wip-filter');
    const topicOptions = document.querySelectorAll<HTMLElement>('.topic-option');
    const cards = document.querySelectorAll<HTMLElement>('.experiment-card');
    const resetBtn = document.querySelector('button[type="reset"]');

    const clearUrlParams = () => {
        if (window.location.search) {
            const cleanUrl = window.location.pathname + window.location.hash;
            window.history.replaceState({}, document.title, cleanUrl);
        }
    };

    const filter = () => {
        const wipOnly = wipFilter?.checked ?? false;
        const activeTopics = new Set(
            Array.from(topicFilters)
                .filter(element => element.checked)
                .map(element => element.value)
        );

        topicOptions.forEach(option => {
            const topic = option.dataset.topic;
            const matchingCount = Array.from(cards).filter(card =>
                (!wipOnly || card.dataset.wip === 'true') && card.dataset.topic === topic
            ).length;
            const count = option.querySelector<HTMLElement>('.filter-choice-count');
            const selected = option.querySelector<HTMLInputElement>('.topic-filter')?.checked ?? false;

            if (count) count.textContent = String(matchingCount);
            option.hidden = matchingCount === 0 && !selected;
        });

        cards.forEach(card => {
            const matchesWip = !wipOnly || card.dataset.wip === 'true';
            const matchesTopic = activeTopics.size === 0 || activeTopics.has(card.dataset.topic ?? '');
            card.style.display = matchesWip && matchesTopic ? '' : 'none';
        });
    };

    const urlParams = new URLSearchParams(window.location.search);
    const wipParam = urlParams.get('wip');
    const topicParam = urlParams.get('topic');
    let appliedUrlFilter = false;

    if (wipParam === 'true' && wipFilter) {
        wipFilter.checked = true;
        appliedUrlFilter = true;
    }

    if (topicParam) {
        const targetFilter = Array.from(topicFilters).find(element => element.value === topicParam);
        if (targetFilter) {
            targetFilter.checked = true;
            appliedUrlFilter = true;
        }
    }

    if (appliedUrlFilter) {
        filter();
        clearUrlParams();
    }

    topicFilters.forEach(input => input.addEventListener('change', () => {
        filter();
        clearUrlParams();
    }));

    wipFilter?.addEventListener('change', () => {
        if (wipFilter.checked) {
            topicFilters.forEach(topicFilter => {
                const hasWipProjects = Array.from(cards).some(card =>
                    card.dataset.wip === 'true' && card.dataset.topic === topicFilter.value
                );
                if (!hasWipProjects) topicFilter.checked = false;
            });
        }
        filter();
        clearUrlParams();
    });
    
    resetBtn?.addEventListener('click', () => {
        setTimeout(() => {
            filter();
            clearUrlParams();
        }, 10);
    });
};

setupFilters();
document.addEventListener('astro:after-swap', setupFilters);
</script>
