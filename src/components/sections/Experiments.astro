---
import { getCollection, getEntry } from 'astro:content';

import { toSlug } from '@utils/userPreferences';
import type { ContentDataEntryType } from '@app-types/Content';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import type { Experiment, ExperimentRole } from '@schemas/ExperimentSchema';
import { CONTENT } from '@app-types/Content';
import { BadgeList, LinkButton, Section, Badge, AsyncImage } from "../";
import Logo from '@assets/svg/case_of_studies.svg';
import TrashIcon from '@assets/svg/trash.svg';
import ChevronIcon from '@assets/svg/chevron.svg';
import ExperimentAbstractModal from './ExperimentAbstractModal.astro'

const roleIcons: Record<ExperimentRole, string> = {
    'Author': '🧑🏻‍💻',
    'Contributor': '🤝🏼'
};

const { lang } = Astro.params;

const [commonData, [ experimentsData ]] = await Promise.all([
    await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`),
    await getCollection(lang as ContentDataEntryType, (collection) => collection.id === `${lang}/${CONTENT.EXPERIMENTS}`)
]);

const { section_experiments, common, header } = (commonData?.data as AboutMeData) || {};
const { data: experiments } = experimentsData as { data: Experiment[]};

const experimentsToDisplay = experiments.filter(exp => exp.display && !exp.isSandbox);
const uniqueCategories = Array.from(
    experimentsToDisplay.reduce((map, { category }) => {
        if (!map.has(category)) {
            map.set(category, { category, slug: toSlug(category), count: 0 });
        }
        map.get(category).count += 1;
        return map;
    }, new Map()).values()
);

const featuredExperiments = experimentsToDisplay.filter(exp => !exp.isSandbox);
const sandboxExperiments = experimentsToDisplay.filter(exp => exp.isSandbox);
---

<div class="bg-primary/5 py-10" id={header.main_sections[2].anchorId}>
    <br />
    <Section headingTitle={section_experiments.title} subtitle={section_experiments.subtitle} class="container mx-auto px-1 lg:px-10">
        <Logo slot="beforeHeading" width={96} height={96} />
        <br />
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 px-2 md:px-14 mt-6 items-start">
            <aside class="lg:col-span-1 lg:sticky lg:top-24 space-y-6 self-start">
                <div class="p-6 rounded-lg filter-panel">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-400 mb-6">
                        {common.filter_experience}
                    </h3>
                    <form class="flex flex-col gap-4">
                        {uniqueCategories.map(({category, slug, count}) => (
                            <div class="flex items-center gap-3 w-full">
                                <input 
                                    class="checkbox checkbox-primary checkbox-sm category-filter"
                                    type="checkbox" 
                                    id={slug}
                                    value={category}
                                    name="experiments_type" 
                                />
                                <label 
                                    for={slug} 
                                    class="cursor-pointer font-medium text-xs filter-label flex-1 flex items-center justify-between" 
                                    data-category={category}
                                >
                                    <span>{category}</span>
                                    <span class="badge badge-ghost badge-sm font-semibold">
                                        {count}
                                    </span>
                                </label>
                            </div>
                        ))}
                        <div class="pt-4 flex border-t border-neutral-200">
                            <button type="reset" class="btn btn-sm btn-circle btn-primary" aria-label="Reset Filters">
                                <TrashIcon class="w-4 h-4" />
                            </button>
                        </div>
                    </form>
                </div>

                <!--TODO: Review these projects before displaying the section -->
                <!-- {sandboxExperiments.length > 0 && (
                    <div class="lg:block p-5 rounded-lg sandbox-panel">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-400">🧪 {common.laboratory}</h3>
                        <div class="flex flex-col gap-2 pt-6">
                            {sandboxExperiments.map((exp) => (
                                <a 
                                    href={exp.url} 
                                    target="_blank" 
                                    rel="noopener noreferrer" 
                                    class="group flex items-center gap-3 p-2 rounded-lg hover:bg-neutral-100/30 transition-all duration-200 sandbox-link"
                                >
                                    <h4 class="flex-1 font-medium text-xs text-neutral-700 group-hover:text-primary transition-colors sandbox-link-title leading-5">
                                        {exp.title}
                                    </h4>
                                    <span class="chevron-icon">
                                        <ChevronIcon />
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                )} -->

            </aside>
            <main class="lg:col-span-3 space-y-8">
                {featuredExperiments.map((experiment: Experiment, index) => (
                    <div class="card experiment-card flex flex-col w-full bg-base-100" data-category={experiment.category}>
                        <div class="experiment-image-wrap">
                            <figure class="experiment-image-stage">
                                <div class="experiment-image-frame">
                                    <div class="experiment-image-reflection"></div>
                                    <AsyncImage 
                                        imagePath={experiment.image} 
                                        title={experiment.title} 
                                        loading="lazy"
                                    />
                                </div>
                            </figure>
                        </div>
                        <div class="p-8 flex flex-col justify-between flex-1">
                                <div class="flex flex-col gap-2 sm:flex-row sm:justify-between sm:items-center mb-2">
                                    <div class="flex flex-wrap gap-2">
                                        <Badge class="badge-sm badge-primary uppercase">{experiment.category}</Badge>
                                        {experiment.year && <Badge class="badge-warning font-semibold badge-sm">{experiment.year}</Badge>}
                                    </div>
                                    {experiment.url && (
                                        <div class="flex gap-3 items-center justify-between sm:justify-end w-full sm:w-auto mt-1 sm:mt-0">
                                            {experiment.abstract && (
                                                <button 
                                                    class="btn btn-outline btn-xs text-secondary" 
                                                    onclick={`document.getElementById('experiment_modal_${index}')?.showModal()`} 
                                                    aria-haspopup="dialog" 
                                                    aria-label={common.abstract}
                                                >
                                                    {common.abstract}
                                                </button>
                                            )}
                                            <LinkButton
                                                href={experiment.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class='btn-circle btn-sm'
                                                displayDefaultIcon
                                                aria-label={`Open experiment: ${experiment.title}`}
                                                title={`Open experiment: ${experiment.title}`}
                                            >
                                                <span class="sr-only">Open experiment: {experiment.title}</span>
                                            </LinkButton>
                                        </div>
                                    )}
                                </div>
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="text-xl">{roleIcons[experiment.role]}</span>
                                    <span class="text-xs text-neutral-500 font-medium uppercase">
                                        {experiment.role === "Author" ? `${common.author}` : `${common.contributor}`}
                                    </span>
                                </div>
                                <h2 class="text-xl font-semibold mb-1">{experiment.title}</h2>
                                <div class="mb-3 text-sm font-semibold primary-text">{experiment.type}</div>
                                <p class="text-neutral-800 text-md leading-7 mb-5 card-description">
                                    {experiment.description}
                                </p>
                            <div class="mt-auto pt-4 border-t border-base-300"> 
                                <BadgeList items={experiment.tags} badgeClass="font-semibold badge-soft text-[11px]" />
                            </div>
                        </div>
                        {experiment.abstract && <ExperimentAbstractModal text={experiment.abstract} modalId={`experiment_modal_${index}`} /> }
                    </div>
                ))}
            </main>
        </div>
    </Section>
</div>


<style>
    @reference "@styles/global.css";
    
    .primary-text { @apply text-primary; }
    html[data-theme="dark"] .primary-text { @apply text-accent; }
    
    .card {
        @apply border border-neutral-200/80 overflow-hidden rounded-lg transition-all duration-300 text-neutral-900;
    }
    .card:hover {
        @apply border border-primary/70 shadow-lg shadow-primary/10 -translate-y-1;
    }

    html[data-theme="dark"] .card {
        @apply bg-neutral-900 border-neutral-800 text-white;
    }

    html[data-theme="dark"] .card:hover {
        @apply border-accent/70 shadow-accent/5;
    }

    .filter-panel, .sandbox-panel {
        @apply bg-base-100 border-neutral-200 shadow-sm;
    }

    .filter-label {
        @apply text-neutral-700 dark:text-base-content;
    }

    html[data-theme="dark"] .sandbox-link-title {
        @apply text-white;
    }

    html[data-theme="dark"] .filter-panel, html[data-theme="dark"] .sandbox-panel {
        @apply bg-neutral-900 border-neutral-800 text-white;
    }
    
    .chevron-icon {
        @apply text-xs text-primary group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-200 shrink-0 pr-1;
    }

    html[data-theme="dark"] .chevron-icon {
        @apply text-accent;
    }

    .experiment-image-wrap {
        @apply overflow-hidden border-b border-neutral-200 dark:border-neutral-800;
    }

    .experiment-image-stage {
        @apply relative flex w-full items-center justify-center overflow-hidden p-3 md:p-6;
        background-color: #fafafa;
        background-image: radial-gradient(ellipse at 50% 50%, rgba(72,79,217,0.08), transparent 68%), linear-gradient(rgba(0,0,0,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.035) 1px, transparent 1px);
        background-size: auto, 24px 24px, 24px 24px;
    }

    :global(html[data-theme="dark"]) .experiment-image-stage {
        background-color: #0c101b;
        background-image: radial-gradient(ellipse at 50% 50%, rgba(41,242,185,0.08), transparent 68%), linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: auto, 24px 24px, 24px 24px;
    }

    .experiment-image-frame {
        @apply relative z-0 flex h-auto w-full items-center justify-center overflow-hidden rounded-xl border border-neutral-200/70 bg-white p-2 transition-transform duration-500 md:rounded-2xl md:p-3;
        box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }

    :global(html[data-theme="dark"]) .experiment-image-frame {
        @apply border-neutral-800/80 bg-neutral-950;
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    :global(.experiment-image-frame img) {
        @apply relative z-0 h-auto max-h-[460px] w-full rounded-lg object-contain transition-transform duration-700;
    }

    .experiment-card:hover .experiment-image-frame {
        @apply -translate-y-0.5;
    }

    .experiment-card:hover .experiment-image-frame img {
        @apply scale-[1.01];
    }

    .experiment-image-reflection {
        @apply absolute inset-0 pointer-events-none z-10 opacity-40;
        background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 40%, rgba(0,0,0,0.03) 60%, rgba(0,0,0,0) 100%);
    }

    :global(html[data-theme="dark"]) .experiment-image-reflection {
        @apply opacity-20;
        background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 100%);
    }

    @media (prefers-reduced-motion: reduce) {
        .experiment-image-frame,
        :global(.experiment-image-frame img) {
            transition-duration: 0.01ms;
        }
    }

    .card-description {
        @apply dark:text-base-content;
    }
</style>

<script>
    const setupFilters = () => {
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.category-filter');
    const cards = document.querySelectorAll<HTMLElement>('.experiment-card');
    const resetBtn = document.querySelector('button[type="reset"]');

    const clearUrlParams = () => {
        if (window.location.search) {
            const cleanUrl = window.location.pathname + window.location.hash;
            window.history.replaceState({}, document.title, cleanUrl);
        }
    };

    const filter = () => {
        const activeCategories = Array.from(checkboxes)
            .filter(element => element.checked)
            .map(element => element.value);

        cards.forEach(card => {
            const cardCategory = card.dataset.category;
            if (activeCategories.length === 0 || activeCategories.includes(cardCategory!)) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    };

    const urlParams = new URLSearchParams(window.location.search);
    const filterParam = urlParams.get('category');

    if (filterParam) {
        const targetCheckbox = document.getElementById(filterParam) as HTMLInputElement | null;
    
        if (targetCheckbox) {
            targetCheckbox.checked = true;
            filter();
            clearUrlParams();
        }
    }

    checkboxes.forEach(cb => cb.addEventListener('change', () => {
        filter();
        clearUrlParams();
    }));
    
    resetBtn?.addEventListener('click', () => {
        setTimeout(() => {
            filter();
            clearUrlParams();
        }, 10);
    });
};

setupFilters();
document.addEventListener('astro:after-swap', setupFilters);
</script>
