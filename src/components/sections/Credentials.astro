---
import { getEntry } from 'astro:content';

import type { ContentDataEntryType } from '@app-types/Content';
import type { Credentials } from '@schemas/CredentialSchema';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import { CONTENT } from '@app-types/Content';
import Logo from '@assets/svg/certification.svg';
import { Section, LinkButton, VerticalSpacer } from "../";

const { lang } = Astro.params;

const [common, credentials] = await Promise.all([
    await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`),
    await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.CREDENTIALS}`)
]);

const { section_credentials, header } = (common?.data as AboutMeData) || {};
const { credly_credentials, certifications } = (credentials?.data as Credentials) || {};

const certificateCompaniesMap: Record<string, string> = {
    "Massachusetts Institute of Technology (MIT)": "https://upload.wikimedia.org/wikipedia/commons/5/5d/MIT_logo_2003-2023.svg",
    "Management 3.0 Foundation": "https://management30.com/wp-content/uploads/2019/01/Management30_Logo_Colour_SCREEN_72dpi-300x250.png",
    "IBM": "https://upload.wikimedia.org/wikipedia/commons/5/51/IBM_logo.svg",
    "HackerRank": "https://upload.wikimedia.org/wikipedia/commons/4/40/HackerRank_Icon-1000px.png"
};

---

<div class="bg-base-100 py-10" id={header.main_sections[1].anchorId}>
    <br />
    <Section headingTitle={section_credentials.title} subtitle={section_credentials.subtitle} class="container mx-auto px-1 lg:px-10">
        <Logo slot="beforeHeading" width={96} height={96} />
        <VerticalSpacer />
        <div class="credentials-layout">
            <div class="credential-list-wrapper">
                {credly_credentials.map(item => (
                    <a href={item.badge_url} target="_blank" rel="noopener noreferrer" class="credential-item">
                        <img src={item.image_url} width="110" height="110" class="credential-badge" alt={`Credential ${item.name}`} aria-hidden="true" />
                        <span class="credential-name">{item.name}</span>
                    </a>
                ))}
            </div>
            <div class="certifications-column">
                <ul class="certification-list">
                    {certifications.filter(({ display }) => display).map(item => (
                        <li class="certification-item">
                            <div class="certification-logo-wrap">
                                <img class="certification-logo" src={certificateCompaniesMap[item.organization]} alt={`Certification ${item.title}`} aria-hidden="true" />
                            </div>
                            <p class="certification-copy">
                                <span class="certification-organization">{item.organization}</span>
                                <span class="certification-title">{item.title}</span>
                            </p>
                            <LinkButton href={item.url} target="_blank" rel="noopener noreferrer" class="btn-circle certification-link" displayDefaultIcon aria-label={`View certificate: ${item.title}`} />
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </Section>
</div>

<style>
    @reference "@styles/global.css";

    .credentials-layout {
        @apply flex flex-col gap-5 px-2 sm:gap-6 lg:flex-row lg:gap-8 lg:px-10;
    }

    .credential-list-wrapper {
        @apply grid w-full grid-cols-2 gap-3 p-0 sm:gap-4 lg:w-3/5;
    }

    .credential-list-wrapper > .credential-item {
        @apply flex min-w-0 cursor-pointer flex-col items-center justify-center rounded-xl border border-neutral-200 p-3 text-center transition-all duration-300 sm:p-4;
    }

    .credential-badge {
        @apply mb-2 h-16 w-16 object-contain sm:mb-3 sm:h-20 sm:w-20 lg:h-24 lg:w-24;
    }

    .credential-name {
        @apply px-1 text-[13px] font-medium leading-snug text-base-content sm:px-2 sm:text-sm lg:px-4 lg:text-base;
    }
    
    .credential-list-wrapper > .credential-item:hover {
        @apply border-primary/70 shadow-md shadow-primary/10 -translate-y-0.5;
    }

    .certifications-column {
        @apply w-full min-w-0 lg:w-2/5;
    }

    .certification-list {
        @apply m-0 flex list-none flex-col p-0;
    }

    .certification-item {
        @apply flex min-w-0 items-center gap-3 border-b border-base-300 px-2 py-3 transition-colors hover:bg-primary/5 sm:gap-4 sm:px-3 sm:py-4;
    }

    .certification-logo-wrap {
        @apply flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-neutral-100 p-1.5 sm:h-12 sm:w-12 sm:p-2;
    }

    .certification-logo {
        @apply h-full w-full object-contain;
    }

    .certification-copy {
        @apply m-0 min-w-0 flex-1;
    }

    .certification-organization {
        @apply mb-1 block text-[11px] leading-snug sm:text-xs;
        color: var(--color-neutral-400);
    }

    .certification-title {
        @apply block text-sm font-medium leading-snug text-base-content sm:text-base lg:text-lg;
    }

    .certification-link {
        @apply h-9 min-h-9 w-9 shrink-0 sm:h-10 sm:min-h-10 sm:w-10;
    }

    .text-info-content-color {
        @apply text-neutral-400;
    }

    html[data-theme="dark"] .text-info-content-color {
        @apply text-neutral-400;
    }

    html[data-theme="dark"] .credential-list-wrapper > .credential-item {
        @apply bg-neutral-900 border-neutral-800;
    }

    html[data-theme="dark"] .credential-list-wrapper > .credential-item:hover {
        @apply border-accent/70 shadow-accent/5;
    }

    html[data-theme="dark"] .list-row img {
        @apply bg-neutral-950;
    }

    html[data-theme="dark"] .certification-logo-wrap {
        @apply bg-neutral-950;
    }

    html[data-theme="dark"] .certification-item {
        @apply border-neutral-800 hover:bg-accent/5;
    }
</style>