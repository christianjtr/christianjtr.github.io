---
import { getCollection, getEntry } from 'astro:content';

import type { ContentDataEntryType } from '@app-types/Content';
import type { Project, WorkCaseStudy } from '@schemas/ProjectSchema';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import { CONTENT } from '@app-types/Content';
import { LinkButton, Section, BadgeList, Badge, AsyncImage, VerticalSpacer } from "@components";
import WorkCaseStudyModal from '@components/modals/WorkCaseStudyModal.astro';
import Logo from '@assets/svg/projects.svg';
import PinIcon from '@assets/svg/pin.svg';
import MonitorIcon from '@assets/svg/monitor.svg';
import ChevronIcon from '@assets/svg/chevron.svg';

const { lang } = Astro.params;

const [commonData, [ projectData ], [ workcaseData ]] = await Promise.all([
    await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`),
    await getCollection(lang as ContentDataEntryType, (collection) => collection.id === `${lang}/${CONTENT.PROJECTS}`),
    await getCollection(lang as ContentDataEntryType, (collection) => collection.id === `${lang}/${CONTENT.WORKCASESTUDY}`),
]);

const { section_projects, common, header } = (commonData?.data as AboutMeData) || {};
const { data: projects } = projectData as { data: Project[] };
const { data: workcases } = workcaseData as { data: WorkCaseStudy[] };
---

<div class="bg-primary/5 py-10" id={header.main_sections[0].anchorId}>
    <Section headingTitle={section_projects.title} subtitle={section_projects.subtitle} class="container mx-auto px-1 lg:px-10">
        <Logo slot="beforeHeading" width={96} height={96} />
        <VerticalSpacer />
        <div class="projects-layout">
            <div class="projects-list">
                {projects.map((project: Project, index: number) => (
                    <div class="collapse collapse-arrow project-card" tabindex="0">
                        <input type="radio" name="project" checked={index === 0} aria-label={
                            `Select project ${project.title}`
                        } />
                        <div class="collapse-title card-header">
                            <div class="tech-timeline-indicator">
                                <div class="timeline-dot-outer">
                                    <div class="timeline-dot-inner"></div>
                                </div>
                                <div class="timeline-line-track">
                                    <div class="timeline-line-active"></div>
                                </div>
                            </div>
                            <div class="header-text-container">
                                <div class="project-header-meta">
                                    <span class="primary-text owner-text">{project.owner}</span>
                                    <span class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                                </div>
                                <h2 class="title">{project.title}</h2>
                                <p class="summary">{project.summary}</p>
                            </div>
                        </div>
                        <div class="collapse-content card-body">
                            <div class="body-grid">
                                
                                <div class="text-column">
                                    <div class="info-section">
                                        <h4 class="section-title text-muted-label">{common.overview}</h4>
                                        <p class="project-paragraph text-body-content mt-7">{project.overview}</p>
                                    </div>
                                    <div class="info-section">
                                        <h4 class="section-title text-muted-label">{common.contribuition}</h4>
                                        <p class="project-paragraph text-body-content mt-7">{project.contributions}</p>
                                    </div>
                                </div>

                                <div class="media-column">
                                    <figure>
                                        <div class="industrial-matte-sheet">
                                            <div class="glass-reflection-overlay"></div>
                                            <AsyncImage 
                                                imagePath={project.project_asset} 
                                                title={project.title} 
                                            />
                                        </div>
                                    </figure>
                                    <div class="info-section">
                                        <h4 class="section-title text-muted-label">{common.project_result_title}</h4>
                                        <p class="project-paragraph text-body-content mt-7">{project.outcome}</p>
                                    </div>
                                    <div class="tech-container">
                                        <MonitorIcon width={14} height={14} class="text-neutral-400 shrink-0 mt-0.5" />
                                        <div class="flex-1 space-y-1">
                                            <h4 class="section-title text-muted-label block mb-5">{common.technologies}</h4>
                                            <div class="pt-0.5 text-xs font-medium tracking-wide">
                                                <BadgeList items={project.technologies} badgeClass='badge-sm' />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="footer-meta">
                                    <PinIcon width={14} height={14} class="shrink-0 text-neutral-400" />
                                    <div class="meta-inline-flow">
                                        <span class="font-medium text-showcase">{project.showcased_at}</span>
                                        <span class="text-location">({project.location})</span>
                                        <span class="hidden md:inline text-bullet-separator">•</span>
                                        <Badge class="badge-warning font-semibold badge-sm">{project.period}</Badge>
                                    </div>
                                </div>
                                <div class="footer-action-wrapper">
                                    <LinkButton href={project.url} class="btn-md w-full md:w-auto flex justify-center" target="_blank" rel="noopener noreferrer" displayDefaultIcon>
                                        {common.view_more}
                                    </LinkButton>
                                </div>
                            </div>
                        </div>
                    </div>    
                ))}
            </div>
            <aside class="workcase-sidebar" aria-label={section_projects.title}>
                <ul class="workcase-list">
                    {workcases.filter(({ display }) => display).map((item, index) => (
                        <li>
                            <button
                                type="button"
                                class="workcase-card group cursor-pointer"
                                aria-haspopup="dialog"
                                aria-controls={`workcase_modal_${index}`}
                                onclick={`document.getElementById('workcase_modal_${index}').showModal()`}
                            >
                                <div class="flex items-center text-xs justify-between gap-1 text-base-content/60 mb-2">
                                    <span class="truncate font-medium tracking-wider">
                                        {item.company}
                                    </span>
                                    <span class="shrink-0 text-[10px]">
                                        {item.period}
                                    </span>
                                </div>
                                <figure class="workcase-card-visual">
                                    <AsyncImage imagePath={item.resource} title={item.title} />
                                </figure>
                                <h3 class="workcase-title">{item.title}</h3>
                                <p class="workcase-card-meta justify-between">
                                    <span class="badge badge-primary badge-xs uppercase font-light">{item.category_description}</span>
                                    <ChevronIcon height={20} width={20} class="chevron-icon" />
                                </p>
                            </button>
                        </li>
                    ))}
                </ul>
                <div class="workcase-dialogs">
                    {workcases.filter(({ display }) => display).map((item, index) => (
                        <WorkCaseStudyModal workcase={item} modalId={`workcase_modal_${index}`} />
                    ))}
                </div>
            </aside>
        </div>
    </Section>
</div>


<style>
    @reference "@styles/global.css";

    .primary-text { @apply text-primary; }
    :global(html[data-theme="dark"]) .primary-text { @apply text-accent; }

    .projects-layout {
        @apply grid grid-cols-1 gap-6 px-2 md:px-10 lg:grid-cols-[minmax(0,1fr)_minmax(16rem,0.32fr)] lg:items-start;
    }
    .projects-list { @apply order-2 min-w-0 lg:order-1; }
    .workcase-sidebar { @apply order-1 min-w-0 lg:sticky lg:top-24 lg:order-2; }
    .workcase-list { @apply m-0 grid grid-cols-[minmax(0,1fr)] list-none gap-3 p-0; }
    .workcase-list > li { @apply min-w-0; }
    .workcase-card {
        @apply block min-w-0 w-full overflow-hidden rounded-xl border border-neutral-200/80 bg-base-100 p-3 text-left text-base-content shadow-xs transition duration-200;
        @apply hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary;
    }
    :global(html[data-theme="dark"]) .workcase-card {
        @apply border-neutral-800 bg-neutral-900 hover:border-accent/60 hover:shadow-accent/5 focus-visible:outline-accent;
    }
    .workcase-company { @apply mb-2 block truncate text-xs font-semibold tracking-wide text-base-content/65; }
    .workcase-card-visual { @apply mb-3 w-full min-w-0 aspect-2/1 overflow-hidden rounded-xl bg-base-200; }
    :global(.workcase-card-visual img) { @apply h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]; }
    .workcase-title { @apply block text-sm font-medium leading-snug tracking-tight text-base-content transition-colors group-hover:text-primary; }
    :global(html[data-theme="dark"]) .workcase-title { @apply group-hover:text-accent; }
    .workcase-card-meta { @apply mt-3 flex items-center gap-2; }
    .workcase-period { @apply min-w-0 flex-1 truncate text-[11px] text-base-content/55; }
    .workcase-dialogs { @apply contents; }

    @media (max-width: 1023px) {
        .workcase-card-visual { display: none; }
        .workcase-card { @apply rounded-xl px-4 py-3; }
        .workcase-title { @apply text-sm leading-snug; }
        .workcase-card-meta { @apply mt-2; }
    }

    .project-card { 
        @apply border mb-6 p-3 rounded-xl transition-all duration-300 relative overflow-hidden; 
        @apply bg-base-100 border-neutral-200/80 text-neutral-800 shadow-xs;
    }
    .project-card:hover { 
        @apply border-primary/70 shadow-lg shadow-primary/5 -translate-y-1; 
    }
    
    :global(html[data-theme="dark"]) .project-card {
        @apply bg-neutral-900 border-neutral-800 text-white shadow-none;
    }
    :global(html[data-theme="dark"]) .project-card:hover {
        @apply border-accent/70 shadow-lg shadow-accent/5;
    }

    .tech-timeline-indicator {
        @apply flex flex-col items-center shrink-0 w-6 h-full relative select-none md:mt-1;
    }
    .timeline-dot-outer {
        @apply w-3 h-3 rounded-full flex items-center justify-center border bg-neutral-50 z-10 transition-colors duration-300;
        @apply border-neutral-300;
    }
    .timeline-dot-inner {
        @apply w-1.5 h-1.5 rounded-full bg-neutral-400 transition-colors duration-300;
    }
    .timeline-line-track {
        @apply w-px absolute top-3 bottom-0 bg-neutral-200 transition-colors duration-300;
    }
    .timeline-line-active {
        @apply w-full h-0 bg-primary transition-all duration-500 ease-out;
    }

    :global(html[data-theme="dark"]) .timeline-dot-outer { @apply border-neutral-700 bg-neutral-800; }
    :global(html[data-theme="dark"]) .timeline-line-track { @apply bg-neutral-800; }
    :global(html[data-theme="dark"]) .timeline-line-active { @apply bg-accent; }

    .project-card:hover .timeline-dot-outer,
    .project-card:has(input:checked) .timeline-dot-outer {
        @apply border-primary bg-primary/5;
    }
    :global(html[data-theme="dark"]) .project-card:hover .timeline-dot-outer,
    :global(html[data-theme="dark"]) .project-card:has(input:checked) .timeline-dot-outer {
        @apply border-accent bg-accent/5;
    }
    .project-card:hover .timeline-dot-inner,
    .project-card:has(input:checked) .timeline-dot-inner {
        @apply bg-primary;
    }
    :global(html[data-theme="dark"]) .project-card:hover .timeline-dot-inner,
    :global(html[data-theme="dark"]) .project-card:has(input:checked) .timeline-dot-inner {
        @apply bg-accent;
    }
    .project-card:has(input:checked) .timeline-line-active {
        @apply h-full;
    }

    .card-header { @apply flex flex-row items-start gap-5 p-6 md:p-8 select-none; }
    .header-text-container { @apply flex min-w-0 grow flex-col gap-2.5 pr-6; }
    .project-header-meta { @apply flex items-center justify-between gap-4; }
    .project-index {
        @apply shrink-0 font-mono text-sm font-semibold tracking-widest text-neutral-300 transition-colors duration-300;
    }
    :global(html[data-theme="dark"]) .project-index { @apply text-neutral-700; }
    .project-card:has(input:checked) .project-index { @apply text-primary/70; }
    :global(html[data-theme="dark"]) .project-card:has(input:checked) .project-index { @apply text-accent/70; }
    .title { @apply text-xl font-extrabold leading-tight tracking-tight text-neutral-800 transition-colors duration-300 md:text-2xl; }
    :global(html[data-theme="dark"]) .title { @apply text-white; }
    .summary {
        @apply line-clamp-2 max-w-3xl text-sm font-normal leading-relaxed text-neutral-700 transition-colors duration-300;
    }
    .project-card:has(input:checked) .summary { @apply line-clamp-none; }
    :global(html[data-theme="dark"]) .summary { @apply text-gray-400; }
    .owner-text { @apply block truncate text-[11px] font-bold uppercase tracking-[0.12em]; }
    .project-card:has(input:checked) .title { @apply text-primary; }
    :global(html[data-theme="dark"]) .project-card:has(input:checked) .title { @apply text-accent; }

    .card-body { @apply pb-4 pl-5 pt-0 md:pl-20; }
    .body-grid { @apply grid grid-cols-1 lg:grid-cols-12 gap-10 pt-6; }

    .text-column { @apply space-y-6 col-span-full lg:col-span-4; }
    .info-section { @apply space-y-1.5; }
    .section-title { @apply text-xs font-bold uppercase tracking-wider block text-neutral-400; }
    :global(html[data-theme="dark"]) .section-title { @apply text-gray-500; }
    
    .project-paragraph { @apply text-base leading-relaxed font-normal text-neutral-600; }
    :global(html[data-theme="dark"]) .project-paragraph { @apply text-gray-300; }

    .media-column { @apply flex flex-col gap-5 col-span-full lg:col-span-8; }

    .visual-studio-mesh {
        @apply relative flex w-full items-center justify-center overflow-hidden rounded-2xl border border-neutral-100 p-3 transition-colors duration-300 md:p-6;
        background-color: #fafafa;
        background-image: radial-gradient(ellipse at 50% 50%, rgba(72,79,217,0.08), transparent 68%), linear-gradient(rgba(0,0,0,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.035) 1px, transparent 1px);
        background-size: auto, 24px 24px, 24px 24px;
    }
    :global(html[data-theme="dark"]) .visual-studio-mesh {
        @apply border-neutral-800/80;
        background-color: #0c101b;
        background-image: radial-gradient(ellipse at 50% 50%, rgba(41,242,185,0.08), transparent 68%), linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: auto, 24px 24px, 24px 24px;
    }

    .industrial-matte-sheet {
        @apply relative z-0 flex h-auto w-full items-center justify-center overflow-hidden rounded-xl border border-neutral-200/70 bg-white p-2 transition-transform duration-500 md:rounded-2xl md:p-3;
    }
    :global(html[data-theme="dark"]) .industrial-matte-sheet {
        @apply border-neutral-800/80 bg-neutral-950;
    }
    .project-card:has(input:checked) .industrial-matte-sheet { @apply -translate-y-0.5; }
    :global(.industrial-matte-sheet img) {
        @apply relative z-0 h-auto max-h-[460px] w-full rounded-lg object-contain transition-transform duration-700;
    }
    .project-card:has(input:checked) .industrial-matte-sheet img { @apply scale-[1.01]; }

    .glass-reflection-overlay {
        @apply absolute inset-0 pointer-events-none z-10 opacity-40;
        background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 40%, rgba(0,0,0,0.03) 60%, rgba(0,0,0,0) 100%);
    }
    :global(html[data-theme="dark"]) .glass-reflection-overlay {
        @apply opacity-20;
        background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 100%);
    }

    .chevron-icon {
        @apply text-primary group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-200 shrink-0 pr-1;
    }

    html[data-theme="dark"] .chevron-icon {
        @apply text-accent;
    }

    .tech-container { @apply flex items-start gap-2.5 pt-1; }

    .card-footer { 
        @apply flex flex-col md:flex-row items-start md:items-center justify-between gap-5 mt-8 pt-4 border-t border-neutral-200; 
    }
    :global(html[data-theme="dark"]) .card-footer { @apply border-t border-neutral-800/60; }
    
    .footer-meta { @apply flex items-center gap-2 text-xs text-neutral-500 w-full md:w-auto; }
    :global(html[data-theme="dark"]) .footer-meta { @apply text-gray-400; }
    .meta-inline-flow { @apply flex flex-wrap items-center gap-x-2 gap-y-1 grow; }
    
    .footer-action-wrapper {
        @apply w-full md:w-auto flex justify-start md:justify-end;
    }

    .text-showcase { @apply text-neutral-700; }
    :global(html[data-theme="dark"]) .text-showcase { @apply text-gray-300; }
    .text-location { @apply text-neutral-400; }
    :global(html[data-theme="dark"]) .text-location { @apply text-neutral-500; }
    .text-bullet-separator { @apply text-neutral-300; }
    :global(html[data-theme="dark"]) .text-bullet-separator { @apply text-neutral-700; }
    figure { @apply w-full; }

    @media (prefers-reduced-motion: reduce) {
        .project-index,
        .title,
        .summary,
        .visual-studio-mesh,
        .industrial-matte-sheet,
        :global(.industrial-matte-sheet img) {
            transition-duration: 0.01ms;
        }
    }
</style>
