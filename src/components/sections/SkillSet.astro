---
import { getEntry, getCollection } from 'astro:content';

import type { ContentDataEntryType } from '@app-types/Content';
import type { Experiment } from '@schemas/ExperimentSchema';
import type { AboutMeData } from '@schemas/AboutMeSchema';
import { CONTENT } from '@app-types/Content';
import Logo from '@assets/svg/people.svg';
import { Section, VerticalSpacer } from "@components";

const { lang } = Astro.params;

const [commonData, [ experimentsData ]] = await Promise.all([
    await getEntry(lang as ContentDataEntryType, `${lang}/${CONTENT.COMMON}`),
    await getCollection(lang as ContentDataEntryType, (collection) => collection.id === `${lang}/${CONTENT.EXPERIMENTS}`)
]);


const { section_skills, section_about, common } = (commonData?.data as AboutMeData) || {};
const { data: experiments } = experimentsData as { data: Experiment[] };

const wipExperiment = experiments.find((experiment) => experiment.isWIP && experiment.display && !experiment.isSandbox);
const hasInProgressExperiments = Boolean(wipExperiment);
type StyleItem = { text: string; bg: string; };

const stylesMap: Record<string, StyleItem> = {
  product: { text: 'text-cyan-400', bg: 'bg-cyan-500/40' },
  coding: { text: 'text-fuchsia-400', bg: 'bg-fuchsia-500/40' },
  data: { text: 'text-emerald-400', bg: 'bg-emerald-500/40' },
  ai: { text: 'text-violet-400', bg: 'bg-violet-500/40' }
};

const skills = section_about.expertise.subjects.map((subject) => {
  const key = subject.category.toLowerCase();
  const config = stylesMap[key] || stylesMap.coding;
  return {
    id: key,
    name: subject.name,
    category: subject.category.toUpperCase(),
    tools: subject.tools,
    ...config
  };
});
---

<div class="bg-base-300 py-10">
  <Section headingTitle={section_skills.title} subtitle={section_skills.subtitle} class="container mx-auto px-1 lg:px-10">
    <Logo slot="beforeHeading" width={90} height={90} />
    <VerticalSpacer />
  {hasInProgressExperiments && (
        <div class="flex w-full mx-auto px-10 mb-7 md:justify-end justify-center">
            <a href="?wip=true#selected_works" class="btn-wip-indicator">
                <span class="wip-pulse-container">
                    <span class="wip-pulse-ping"></span>
                    <span class="wip-pulse-dot"></span>
                </span>
                <span>{wipExperiment?.category}</span>
                <span class="text-sm font-bold">↓</span>
            </a>
        </div>
    )}
    <div class="group-main">
      <div class="w-full md:w-1/5 flex items-center justify-center md:justify-start z-10">
        <div class="vshape-box vshape-target">
          <h5 class="vshape-text">
            {section_about.v_shaped_profile}
          </h5>
        </div>
      </div>
      <svg class="absolute inset-0 w-full h-full pointer-events-none z-0 hidden md:block" viewBox="0 0 896 320" preserveAspectRatio="none">
        <g fill="none" class="graph-lines">
          <path d="M 120,160 L 140,160 C 165,160 165,45 225,45" class="laser-path line-product"></path>
          <path d="M 120,160 L 140,160 C 165,160 165,120 225,120" class="laser-path line-coding"></path>
          <path d="M 120,160 L 140,160 C 165,160 165,195 225,195" class="laser-path line-data"></path>
          <path d="M 120,160 L 140,160 C 165,160 165,275 225,275" class="laser-path line-ai"></path>
        </g>
      </svg>
      <div class="w-full md:w-4/5 flex flex-col md:flex-row gap-6 items-stretch relative">
        <div class="w-full md:w-2/4 flex flex-col gap-6 justify-center z-10">
          {skills.map((skill) => (
            <div class={`pillar-card pilar-${skill.id} px-5 py-4 rounded-lg cursor-pointer transition-all duration-300 hover:scale-[1.01] flex flex-col gap-3 relative`}>
              <div class="flex items-center justify-between w-full">
                <div class="flex flex-col text-left">
                  <span class="pillar-category text-xs font-bold uppercase tracking-widest">{skill.category}</span>
                  <span class="pillar-name text-sm sm:text-base font-extrabold transition-colors">{skill.name}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="ghost-container w-full md:w-[44%] z-10 relative min-h-[280px]">
          <div class="placeholder-text">
            <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3 placeholder-icon">
              <span class="text-lg font-mono">⇄</span>
            </div>
            <span class="text-xs font-mono uppercase tracking-widest block mb-2">{common.stack}</span>
            <p class="text-sm leading-relaxed font-medium">
              {common.interact_with}
            </p>
          </div>
          {skills.map((skill) => (
            <div class={`topics-list topics-${skill.id} p-5 flex flex-col justify-between h-full absolute inset-0`}>
              <div class="mb-3 pb-2 border-b border-slate-600/50 flex items-center justify-between shrink-0">
                <span class="text-[10px] font-mono uppercase font-bold tracking-wider text-slate-300">
                  {skill.name} • {common.stack}
                </span>
                <span class="text-[10px] font-mono text-slate-400">
                  {skill.tools.length} items
                </span>
              </div>
              <div class="flex flex-wrap gap-2 overflow-y-auto pr-1 scrollbar-thin">
                {skill.tools.map((tool) => (
                  <div class={`topic-pill topic-pill--${skill.id} px-2.5! py-1! text-center`}>
                    <span class="text-[11px] font-semibold">{tool}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <VerticalSpacer />
  </Section>
</div>

<style>
  @reference "@styles/global.css";

  .btn-wip-indicator {
      @apply inline-flex items-center gap-2.5 px-5 py-3 rounded-full 
          text-xs font-mono font-bold uppercase tracking-wider 
          transition-all duration-200 shadow-xs hover:shadow-md cursor-pointer
          bg-primary/10 hover:bg-primary/20 border border-primary/30 text-primary;
    }

  :global(html[data-theme="dark"]) .btn-wip-indicator {
      @apply bg-accent/10 hover:bg-accent/20 border-accent/30 text-accent;
  }

  .wip-pulse-container {
      @apply relative flex h-2.5 w-2.5 shrink-0;
  }

  .wip-pulse-ping {
      @apply animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-primary;
  }

  .wip-pulse-dot {
      @apply relative inline-flex rounded-full h-2.5 w-2.5 bg-primary;
  }

  :global(html[data-theme="dark"]) .wip-pulse-ping,
  :global(html[data-theme="dark"]) .wip-pulse-dot {
      @apply bg-accent;
  }

  /* ==================== EDITORIAL CARDS ==================== */
  .apple-editorial-grid {
    @apply w-full grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch mb-12 select-none font-sans;
  }

  .editorial-card {
    @apply border rounded-lg p-6 md:p-8 flex flex-col justify-between transition-all duration-300 min-h-[180px] w-full;
    background-color: var(--fallback-b1, hsl(var(--b1)));
    border-color: #e5e5e5;
  }

  .editorial-card:hover {
    @apply border border-primary/70 shadow-lg shadow-primary/10 -translate-y-1;
  }

  .background-item {
    @apply border-l-2 border-transparent;
  }

  .background-item:hover {
    @apply border-primary/75;
  }

  html[data-theme="dark"] .background-item:hover {
    @apply border-accent;
  }

  .card-synergy {
    @apply md:col-span-7;
  }

  .card-academy {
    @apply md:col-span-5;
  }

  .card-body-wrapper {
    @apply space-y-4 w-full;
  }

  .card-meta-header {
    @apply flex items-center gap-2 text-neutral-400;
  }

  .card-meta-title {
    @apply text-[10px] font-bold uppercase tracking-widest font-mono;
  }

  .editorial-heading {
    @apply text-lg md:text-xl font-semibold text-neutral-800 tracking-tight leading-snug whitespace-normal max-w-lg;
  }

  .chip-container {
    @apply flex flex-wrap gap-2 mt-3 pt-5 border-t w-full;
    border-color: rgba(229, 229, 229, 0.5);
  }

  .editorial-chip {
    @apply text-[10px] font-mono font-semibold px-2.5 py-1 rounded-md bg-white border border-neutral-200/50 text-neutral-500;
  }

  .highlight-primary {
    @apply font-extrabold text-primary font-mono;
  }

  .highlight-secondary {
    @apply font-extrabold text-accent tabular-nums;
  }

  .academy-footer {
    @apply pt-4 border-t flex items-center justify-between text-[10px] font-bold text-secondary uppercase tracking-wider w-full;
    border-color: rgba(229, 229, 229, 0.5);
  }

  .footer-divider {
    @apply text-neutral-300 select-none font-normal;
  }

  .footer-status {
    @apply text-neutral-400 font-mono text-[9px] font-normal lowercase shrink-0;
  }

  html[data-theme="dark"] .editorial-card {
    @apply bg-neutral-900 border-neutral-800 text-white;
  }

  html[data-theme="dark"] .editorial-card:hover {
    @apply border-accent/70 shadow-accent/5;
  }

  html[data-theme="dark"] .card-meta-header {
    @apply text-neutral-500;
  }

  html[data-theme="dark"] .editorial-heading {
    @apply text-white;
  }

  html[data-theme="dark"] .chip-container,
  html[data-theme="dark"] .academy-footer {
    border-color: rgba(38, 38, 38, 0.5);
  }

  html[data-theme="dark"] .editorial-chip {
    @apply bg-neutral-900 border-neutral-800 text-neutral-400;
  }

  html[data-theme="dark"] .highlight-primary {
    @apply text-accent;
  }

  html[data-theme="dark"] .footer-divider {
    @apply text-neutral-700;
  }

  /* ==================== V-SHAPE & PILLAR CARDS ==================== */
  .vshape-box, .pillar-card { 
    @apply bg-base-100 border border-slate-400 text-slate-700; 
  }

  .vshape-box {
    @apply relative overflow-hidden rounded-2xl;
    background-color: #f8fafc;
    border-color: rgba(72, 79, 217, 0.32);
    box-shadow: 0 10px 24px -20px rgba(72, 79, 217, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .vshape-target {
    @apply w-full max-w-[150px] p-4 text-center transition-all duration-300;
  }

  .vshape-text {
    @apply text-balance font-mono text-sm leading-normal font-bold tracking-widest uppercase transition-colors;
  }

  .vshape-box::after {
    content: "";
    @apply absolute -right-5 -top-5 h-16 w-16 rounded-full border;
    border-color: rgba(41, 242, 185, 0.38);
    box-shadow: 0 0 0 8px rgba(41, 242, 185, 0.05);
  }

  :global(html[data-theme="dark"]) .vshape-box {
    @apply border-neutral-700 bg-neutral-950 text-white;
    background-color: #0a0f1c;
    box-shadow: 0 12px 26px -22px rgba(41, 242, 185, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .pillar-name { 
    @apply text-slate-800;
  }

  .group-main {
    @apply relative mx-auto flex w-full flex-col items-center gap-6 px-2 md:flex-row md:items-stretch md:gap-4;
  }

  .pillar-card {
    --pillar-accent: #0284c7;
    --pillar-accent-border: rgba(2, 132, 199, 0.3);
    @apply relative isolate overflow-hidden rounded-xl border bg-base-100 transition-all duration-300;
    border-color: var(--pillar-accent-border);
    box-shadow: 0 6px 16px -16px var(--pillar-accent);
  }

  .pillar-card::before {
    content: "";
    @apply absolute bottom-3 left-0 top-3 w-1 rounded-r-full transition-all duration-300;
    background: var(--pillar-accent);
    opacity: 0.8;
  }

  .pilar-product {
    --pillar-accent: #0284c7;
    --pillar-accent-border: rgba(2, 132, 199, 0.34);
  }

  .pilar-coding {
    --pillar-accent: #c026d3;
    --pillar-accent-border: rgba(192, 38, 211, 0.32);
  }

  .pilar-data {
    --pillar-accent: #059669;
    --pillar-accent-border: rgba(5, 150, 105, 0.34);
  }

  .pilar-ai {
    --pillar-accent: #7c3aed;
    --pillar-accent-border: rgba(124, 58, 237, 0.32);
  }

  .pillar-category {
    color: var(--pillar-accent);
  }

  :global(html[data-theme="dark"]) .pillar-card {
    position: relative;
    z-index: 1;
    background-color: #111827 !important;
    border-color: color-mix(in srgb, var(--pillar-accent) 48%, #334155);
    box-shadow: 0 8px 18px -18px var(--pillar-accent);
  }

  :global(html[data-theme="dark"]) .pillar-card::before {
    opacity: 1;
  }
  
  .ghost-container {
    @apply relative overflow-hidden rounded-2xl border border-dashed border-primary/40 p-5 text-center
           mt-4 flex min-h-[280px] flex-col items-center justify-center bg-base-100 md:mt-0 md:min-h-auto;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .placeholder-icon { 
    @apply bg-primary text-white shadow-lg shadow-primary/25;
  }

  .placeholder-text {
    @apply absolute inset-0 m-auto flex flex-col items-center justify-center p-4 text-slate-600 transition-opacity duration-200;
  }

  .topics-list {
    @apply absolute inset-0 z-1 hidden h-full w-full flex-col justify-start overflow-hidden rounded-2xl p-5
           bg-slate-800 transition-all duration-300 opacity-0;
    background-color: #1e293b;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 12px 28px -24px rgba(15, 23, 42, 0.6);
  }

  :global(html[data-theme="dark"]) .ghost-container {
    @apply border-neutral-600 bg-neutral-900;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  :global(html[data-theme="dark"]) .placeholder-icon {
    @apply bg-accent text-neutral-950 shadow-accent/20;
  }

  .topics-product { border-color: rgba(56, 189, 248, 0.52); }
  .topics-coding { border-color: rgba(244, 114, 182, 0.52); }
  .topics-data { border-color: rgba(52, 211, 153, 0.52); }
  .topics-ai { border-color: rgba(192, 132, 252, 0.52); }

  .topic-pill {
    @apply px-3 py-1.5 rounded-lg border text-left shadow-sm scale-95 
           animate-[fadeIn_0.2s_ease-out_forwards] tracking-wide;
    border-color: rgba(148, 163, 184, 0.35);
    background: rgba(15, 23, 42, 0.85);
  }

  /* Dark Theme Elements */
  :global(html[data-theme="dark"]) .pillar-name { @apply text-slate-100; }
  :global(html[data-theme="dark"]) .placeholder-text { @apply text-slate-400; }
  :global(html[data-theme="dark"]) .topics-list {
    background-color: #020617;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 18px 36px -24px rgba(0, 0, 0, 0.8);
  }
  :global(html[data-theme="dark"]) .topic-pill {
    border-color: rgba(148, 163, 184, 0.35);
    background: rgba(15, 23, 42, 0.85);
  }

  /* ==================== SVG GRAPH CONNECTORS ==================== */
  svg .laser-path { 
    stroke: #64748b !important;
    stroke-width: 2px !important;
    opacity: 0.35 !important;
    transition: all 0.3s ease !important; 
  }

  svg .line-product { stroke: #0284c7 !important; opacity: 0.55 !important; }
  svg .line-coding { stroke: #c026d3 !important; opacity: 0.55 !important; }
  svg .line-data { stroke: #059669 !important; opacity: 0.55 !important; }
  svg .line-ai { stroke: #7c3aed !important; opacity: 0.55 !important; }

  /* Atenúa las líneas inactivas en hover */
  .group-main:has(.pillar-card:hover) svg .laser-path {
    opacity: 0.08 !important;
    stroke-width: 1px !important;
  }

  /* LÍNEA ACTIVA HOVERED: acento de color moderado */
  .group-main:has(.pilar-product:hover) svg .line-product { 
    stroke: #0284c7 !important;
    filter: drop-shadow(0 0 2px rgba(2, 132, 199, 0.4)) !important;
    opacity: 1 !important;
    stroke-width: 3px !important;
    stroke-dasharray: 8 6 !important;
    animation: laserStream 1.4s linear infinite !important;
  }

  .group-main:has(.pilar-coding:hover) svg .line-coding { 
    stroke: #c026d3 !important;
    filter: drop-shadow(0 0 2px rgba(192, 38, 211, 0.4)) !important;
    opacity: 1 !important;
    stroke-width: 3px !important;
    stroke-dasharray: 8 6 !important;
    animation: laserStream 1.4s linear infinite !important;
  }

  .group-main:has(.pilar-data:hover) svg .line-data { 
    stroke: #059669 !important;
    filter: drop-shadow(0 0 2px rgba(5, 150, 105, 0.4)) !important;
    opacity: 1 !important;
    stroke-width: 3px !important;
    stroke-dasharray: 8 6 !important;
    animation: laserStream 1.4s linear infinite !important;
  }

  .group-main:has(.pilar-ai:hover) svg .line-ai { 
    stroke: #7c3aed !important;
    filter: drop-shadow(0 0 2px rgba(124, 58, 237, 0.4)) !important;
    opacity: 1 !important;
    stroke-width: 3px !important;
    stroke-dasharray: 8 6 !important;
    animation: laserStream 1.4s linear infinite !important;
  }

  /* LÍNEA ACTIVA HOVERED: Colores brillantes en Tema Oscuro */
  html[data-theme="dark"] .group-main:has(.pilar-product:hover) svg .line-product { 
    stroke: #38bdf8 !important; 
    filter: drop-shadow(0 0 3px rgba(56, 189, 248, 0.5)) !important;
  }
  html[data-theme="dark"] .group-main:has(.pilar-coding:hover) svg .line-coding { 
    stroke: #f472b6 !important; 
    filter: drop-shadow(0 0 3px rgba(244, 114, 182, 0.5)) !important;
  }
  html[data-theme="dark"] .group-main:has(.pilar-data:hover) svg .line-data { 
    stroke: #34d399 !important; 
    filter: drop-shadow(0 0 3px rgba(52, 211, 153, 0.5)) !important;
  }
  html[data-theme="dark"] .group-main:has(.pilar-ai:hover) svg .line-ai { 
    stroke: #c084fc !important; 
    filter: drop-shadow(0 0 3px rgba(192, 132, 252, 0.5)) !important;
  }

  /* ==================== HOVER STATES ==================== */
  .group-main:has(.pilar-product:hover) .topics-product,
  .group-main:has(.pilar-coding:hover) .topics-coding,
  .group-main:has(.pilar-data:hover) .topics-data,
  .group-main:has(.pilar-ai:hover) .topics-ai {
    display: flex !important;
    opacity: 1 !important;
  }

  .group-main:has(.pillar-card:hover) .placeholder-text {
    opacity: 0 !important;
    pointer-events: none;
  }

  /* V-shaped profile container hover que coincide con el fondo de las cards */
  .group-main:has(.pilar-product:hover) .vshape-target,
  .group-main:has(.pilar-coding:hover) .vshape-target,
  .group-main:has(.pilar-data:hover) .vshape-target,
  .group-main:has(.pilar-ai:hover) .vshape-target { 
    background-color: rgba(2, 132, 199, 0.1);
    border-color: #0284c7;
  }

  .group-main:has(.pilar-coding:hover) .vshape-target {
    background-color: rgba(192, 38, 211, 0.1);
    border-color: #c026d3;
  }

  .group-main:has(.pilar-data:hover) .vshape-target {
    background-color: rgba(5, 150, 105, 0.1);
    border-color: #059669;
  }

  .group-main:has(.pilar-ai:hover) .vshape-target {
    background-color: rgba(124, 58, 237, 0.1);
    border-color: #7c3aed;
  }

  :global(html[data-theme="dark"]) .group-main:has(.pillar-card:hover) .vshape-target {
    background-color: #111827;
  }

  .group-main:has(.pilar-product:hover) .vshape-target { border-color: #38bdf8 !important; box-shadow: 0 0 20px rgba(2, 132, 199, 0.4) !important; }
  .group-main:has(.pilar-coding:hover) .vshape-target { border-color: #f472b6 !important; box-shadow: 0 0 20px rgba(192, 38, 211, 0.4) !important; }
  .group-main:has(.pilar-data:hover) .vshape-target { border-color: #34d399 !important; box-shadow: 0 0 20px rgba(5, 150, 105, 0.4) !important; }
  .group-main:has(.pilar-ai:hover) .vshape-target { border-color: #c084fc !important; box-shadow: 0 0 20px rgba(124, 58, 237, 0.4) !important; }

  html[data-theme="dark"] .group-main:has(.pilar-product:hover) .vshape-target { border-color: #38bdf8 !important; box-shadow: 0 0 20px rgba(56, 189, 248, 0.4) !important; }
  html[data-theme="dark"] .group-main:has(.pilar-coding:hover) .vshape-target { border-color: #f472b6 !important; box-shadow: 0 0 20px rgba(244, 114, 182, 0.4) !important; }
  html[data-theme="dark"] .group-main:has(.pilar-data:hover) .vshape-target { border-color: #34d399 !important; box-shadow: 0 0 20px rgba(52, 211, 153, 0.4) !important; }
  html[data-theme="dark"] .group-main:has(.pilar-ai:hover) .vshape-target { border-color: #c084fc !important; box-shadow: 0 0 20px rgba(192, 132, 252, 0.4) !important; }

  .group-main:has(.pilar-product:hover) .vshape-text { color: #38bdf8 !important; }
  .group-main:has(.pilar-coding:hover) .vshape-text { color: #f472b6 !important; }
  .group-main:has(.pilar-data:hover) .vshape-text { color: #34d399 !important; }
  .group-main:has(.pilar-ai:hover) .vshape-text { color: #c084fc !important; }

  html[data-theme="dark"] .group-main:has(.pilar-product:hover) .vshape-text { color: #38bdf8 !important; }
  html[data-theme="dark"] .group-main:has(.pilar-coding:hover) .vshape-text { color: #f472b6 !important; }
  html[data-theme="dark"] .group-main:has(.pilar-data:hover) .vshape-text { color: #34d399 !important; }
  html[data-theme="dark"] .group-main:has(.pilar-ai:hover) .vshape-text { color: #c084fc !important; }

  .pilar-product:hover { background-color: color-mix(in srgb, var(--color-base-100) 92%, #0284c7); }
  .pilar-coding:hover { background-color: color-mix(in srgb, var(--color-base-100) 92%, #c026d3); }
  .pilar-data:hover { background-color: color-mix(in srgb, var(--color-base-100) 92%, #059669); }
  .pilar-ai:hover { background-color: color-mix(in srgb, var(--color-base-100) 92%, #7c3aed); }

  .pilar-product:hover { border-color: #0284c7 !important; box-shadow: 0 8px 22px -18px #0284c7 !important; }
  .pilar-coding:hover { border-color: #c026d3 !important; box-shadow: 0 8px 22px -18px #c026d3 !important; }
